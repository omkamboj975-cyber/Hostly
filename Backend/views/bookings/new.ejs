<% layout('/layouts/boilerplate') %>

  <div class="form-page">
    <div class="form-wrapper">
      <h2 class="form-title">Reserve: <%= listing.title %>
      </h2>
      <p class="form-subtitle">₹ <%= listing.price.toLocaleString('en-IN') %> / night — <%= listing.location %>, <%=
              listing.country %>
      </p>

      <div class="booking-section" data-night-price="<%= listing.price %>">
        <form action="/booking/<%= listing._id %>/bookings" method="POST" class="booking-form needs-validation"
          novalidate>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="checkIn" class="form-label">Check-in</label>
              <input type="date" id="checkIn" name="booking[checkIn]" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label for="checkOut" class="form-label">Check-out</label>
              <input type="date" id="checkOut" name="booking[checkOut]" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label for="guests" class="form-label">Guests</label>
              <input type="number" id="guests" name="booking[guests]" class="form-control" min="1" max="20" value="1"
                required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Estimated total</label>
              <div class="booking-total-box">₹ <span id="bookingTotal">0</span></div>
              <input type="hidden" id="totalPrice" name="booking[totalPrice]" value="0">
            </div>
            <div class="col-12">
              <label for="specialRequests" class="form-label">Special requests</label>
              <textarea id="specialRequests" name="booking[specialRequests]" class="form-control booking-textarea"
                placeholder="Anything we should know before your stay?"></textarea>
            </div>
          </div>

          <div style="display:flex;gap:0.75rem;margin-top:1rem;">
            <button type="button" class="form-submit-btn booking-submit-btn" data-bs-toggle="modal"
              data-bs-target="#paymentModal">Book Now</button>
            <a href="/listing/<%= listing._id %>" class="btn-delete" style="align-self:center;">Back</a>
          </div>
        </form>
      </div>

    </div>
  </div>

  <!-- Demo Payment Modal -->
  <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="paymentModalLabel">Secure Payment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="dummyPaymentForm">
            <div class="mb-3">
              <label for="cardNumber" class="form-label">Card Number</label>
              <input type="text" class="form-control" id="cardNumber" placeholder="0000 0000 0000 0000" required
                pattern="\d{16}" title="16 digit card number">
            </div>
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="expiry" class="form-label">Expiry Date</label>
                <input type="text" class="form-control" id="expiry" placeholder="MM/YY" required pattern="\d{2}/\d{2}"
                  title="MM/YY format">
              </div>
              <div class="col-md-6 mb-3">
                <label for="cvv" class="form-label">CVV</label>
                <input type="password" class="form-control" id="cvv" placeholder="123" required pattern="\d{3,4}"
                  title="3 or 4 digit CVV">
              </div>
            </div>
            <div class="mb-3">
              <label for="nameOnCard" class="form-label">Name on Card</label>
              <input type="text" class="form-control" id="nameOnCard" placeholder="John Doe" required>
            </div>
            <p class="text-muted" style="font-size:0.8rem;">Demo mode: no real money is charged. Use 4111111111111111 to
              succeed, or 4000000000000002 to test a declined payment.</p>
            <button type="submit" id="payNowBtn" class="btn btn-primary w-100 mt-3"
              style="background-color: #fe424d; border: none; padding: 0.75rem; border-radius: 8px;">Pay Now &
              Book</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const paymentForm = document.getElementById("dummyPaymentForm");
      const bookingForm = document.querySelector(".booking-form");
      const payBtn = document.getElementById("payNowBtn");
      const modalEl = document.getElementById("paymentModal");

      const postJSON = async (url, body) => {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body)
        });
        const data = await res.json().catch(() => ({}));
        return { ok: res.ok, data };
      };

      paymentForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Validate the main booking form first
        if (!bookingForm.checkValidity()) {
          const modal = bootstrap.Modal.getInstance(modalEl);
          if (modal) modal.hide();
          bookingForm.reportValidity();
          return;
        }

        payBtn.disabled = true;
        const originalText = payBtn.textContent;
        payBtn.textContent = "Processing...";

        try {
          // 1. Create the order (server calculates the price)
          const order = await postJSON("/booking/<%= listing._id %>/bookings/order", {
            booking: {
              checkIn: document.getElementById("checkIn").value,
              checkOut: document.getElementById("checkOut").value,
              guests: document.getElementById("guests").value,
              specialRequests: document.getElementById("specialRequests").value
            }
          });
          if (!order.ok) throw new Error(order.data.error || "Could not start payment.");

          // 2. Fake gateway decides the outcome from the demo card number.
          //    The card number itself is never sent to the server.
          const card = document.getElementById("cardNumber").value;
          const outcome = card === "4000000000000002" ? "failure" : "success";

          const pay = await postJSON("/booking/bookings/mock-pay", {
            orderId: order.data.orderId,
            outcome
          });
          if (!pay.ok) throw new Error(pay.data.error || "Payment failed.");

          // 3. Server verifies the signature and confirms the booking
          const verify = await postJSON("/booking/bookings/verify", pay.data);
          if (!verify.ok) throw new Error(verify.data.error || "Verification failed.");

          window.location.href = verify.data.redirect;
        } catch (err) {
          alert(err.message || "Something went wrong. Please try again.");
          payBtn.disabled = false;
          payBtn.textContent = originalText;
        }
      });
    });
  </script>